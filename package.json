{
	"name": "bulk-category-manager",
	"version": "1.0.0",
	"description": "Move products in bulk from one product category to another in WooCommerce, with batch processing and progress UI.",
	"main": "index.js",
	"scripts": {
		"composer-update": "composer update",
		"composer-update-no-dev": "composer update --no-dev",
		"start": "cross-env NODE_ENV=development wp-scripts start src/admin/main.jsx --hot",
		"compile": "cross-env NODE_ENV=production wp-scripts build src/admin/main.jsx",
		"compile-unminified": "cross-env NODE_ENV=production-unminified wp-scripts build src/admin/main.jsx --mode production",
		"translate": "wp i18n make-pot . languages/bulk-category-manager.pot --exclude=builds/,node_modules/,src,builds --ignore-domain --allow-root",
		"build": "grunt vendorClean && npm run composer-update-no-dev && grunt preBuildClean && npm run compile && npm run translate && npm run compile-unminified && grunt build:pro && grunt finish && npm run composer-update"
	},
	"repository": {
		"type": "git",
		"url": "git+https://hasanchy@github.com/hasanchy/bulk-category-manager.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/hasanchy/bulk-category-manager/issues"
	},
	"homepage": "https://github.com/hasanchy/bulk-category-manager#readme",
	"dependencies": {
		"@ant-design/charts": "^2.2.7",
		"@reduxjs/toolkit": "^1.9.5",
		"@wordpress/components": "^29.12.0",
		"@wordpress/i18n": "^5.1.0",
		"antd": "^5.22.5",
		"antd-style": "^3.7.1",
		"axios": "^1.3.2",
		"country-flag-icons": "^1.5.13",
		"react-error-boundary": "^4.0.9",
		"react-redux": "^8.0.5",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@wordpress/scripts": "^25.3.0",
		"cross-env": "^7.0.3",
		"grunt": "^1.0.4",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-contrib-clean": "^2.0.0",
		"grunt-contrib-compress": "^1.6.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-contrib-rename": "^0.2.0",
		"grunt-phpunit": "^0.3.6",
		"grunt-replace": "^1.0.1",
		"grunt-search": "^0.1.8",
		"grunt-wp-i18n": "^1.0.3",
		"gulp": "4.0.2",
		"load-grunt-tasks": "^5.1.0",
		"npm-run-all": "^4.1.5"
	}
}
